---
import Layout from '../layouts/Layout.astro';
import { API_URL } from '../lib/api';
import { getSession } from 'auth-astro/server';

const session = await getSession(Astro.request);
if (session) {
	return Astro.redirect('/dashboard');
}
---

<Layout title="Iniciar Sesión | FinanceAI">
	<div class="min-h-[calc(100vh-73px)] flex flex-col lg:flex-row w-full bg-white dark:bg-gray-950">
		<!-- Left Panel (Dark Branding & Metrics) -->
		<div class="lg:w-1/2 bg-[#0b132b] text-white p-10 sm:p-16 lg:p-20 flex flex-col justify-between relative overflow-hidden">
			<!-- Glow backdrop -->
			<div class="absolute -top-32 -left-32 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
			<div class="absolute -bottom-32 -right-32 w-96 h-96 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

			<!-- Top Dots -->
			<div class="flex space-x-2.5 mb-12">
				<div class="w-3 h-3 rounded-full bg-blue-500"></div>
				<div class="w-3 h-3 rounded-full bg-red-500"></div>
				<div class="w-3 h-3 rounded-full bg-yellow-400"></div>
			</div>

			<!-- Center Content -->
			<div class="my-auto py-8">
				<h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.1] mb-6">
					Inteligencia<br/>financiera<br/>a tu medida.
				</h1>
				<p class="text-slate-400 text-lg sm:text-xl max-w-lg leading-relaxed font-normal">
					Analiza tus finanzas, registra tus gastos y toma mejores decisiones respaldadas por datos en tiempo real.
				</p>
			</div>
			
			<!-- Bottom Metrics -->
			<div class="grid grid-cols-3 gap-6 pt-12 border-t border-slate-800/80">
				<div>
					<div class="text-2xl sm:text-3xl font-bold tracking-tight text-white">$148K</div>
					<div class="text-[11px] text-slate-500 font-semibold tracking-widest mt-1.5 uppercase">PORTAFOLIO</div>
				</div>
				<div>
					<div class="text-2xl sm:text-3xl font-bold tracking-tight text-emerald-400">+18.4%</div>
					<div class="text-[11px] text-slate-500 font-semibold tracking-widest mt-1.5 uppercase">RENDIMIENTO</div>
				</div>
				<div>
					<div class="text-2xl sm:text-3xl font-bold tracking-tight text-white">74/100</div>
					<div class="text-[11px] text-slate-500 font-semibold tracking-widest mt-1.5 uppercase">SALUD FIN.</div>
				</div>
			</div>
		</div>

		<!-- Right Panel (Form - Only Email & Password) -->
		<div class="w-full lg:w-1/2 flex items-center justify-center p-6 sm:p-12 lg:p-16 bg-white dark:bg-gray-950">
			<div class="max-w-md w-full mx-auto space-y-6">
				<!-- Header -->
				<div class="text-left">
					<h2 id="formTitle" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white">Bienvenido de nuevo</h2>
					<p id="formSubtitle" class="text-sm text-gray-500 dark:text-gray-400 mt-1.5">Accede a tu panel financiero</p>
				</div>

				<!-- Notification Alert -->
				<div id="alertBox" class="hidden p-3.5 rounded-xl text-sm font-medium"></div>

				<!-- Main Form -->
				<form id="authForm" class="space-y-4" aria-label="Formulario de autenticación">
					<!-- Extra Register Fields (Hidden in Login Mode) -->
					<div id="registerFields" class="hidden space-y-4">
						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Nombre</label>
								<input type="text" id="nombre" placeholder="Tu nombre"
									class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
							</div>
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Apellido</label>
								<input type="text" id="apellido" placeholder="Tu apellido"
									class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
							</div>
						</div>

						<div class="grid grid-cols-2 gap-3">
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">País (ID)</label>
								<select id="paisId" class="w-full px-3 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition">
									<option value="1">1 - Costa Rica</option>
									<option value="2">2 - México</option>
									<option value="3">3 - Estados Unidos</option>
									<option value="4">4 - España</option>
									<option value="5">5 - Colombia</option>
								</select>
							</div>
							<div>
								<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Moneda (ID)</label>
								<select id="monedaId" class="w-full px-3 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition">
									<option value="1">1 - CRC (₡)</option>
									<option value="2">2 - MXN ($)</option>
									<option value="3">3 - USD ($)</option>
									<option value="4">4 - EUR (€)</option>
									<option value="5">5 - COP ($)</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Email -->
					<div>
						<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Correo electrónico</label>
						<input type="email" id="email" required aria-required="true" aria-label="Correo electrónico" placeholder="tu@correo.com"
							class="w-full px-3.5 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
					</div>

					<!-- Password with Visibility Toggle -->
					<div>
						<label class="block text-xs font-semibold text-gray-700 dark:text-gray-300 mb-1">Contraseña</label>
						<div class="relative">
							<input type="password" id="password" required aria-required="true" aria-label="Contraseña" placeholder="••••••••"
								class="w-full pl-3.5 pr-11 py-2.5 text-sm bg-gray-50 dark:bg-gray-900 border border-gray-300 dark:border-gray-700 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-600 dark:text-white transition" />
							<button type="button" id="togglePasswordBtn"
								class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition focus:outline-none"
								title="Mostrar u ocultar contraseña" aria-label="Mostrar u ocultar contraseña">
								<!-- Eye Icon (Show password) -->
								<svg id="eyeIcon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
								</svg>
								<!-- Eye Off Icon (Hide password) -->
								<svg id="eyeOffIcon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
								</svg>
							</button>
						</div>
					</div>

					<!-- Forgot password link -->
					<div id="forgotPasswordContainer" class="flex justify-end pt-1">
						<a href="#" class="text-xs font-medium text-blue-600 hover:text-blue-700 dark:text-blue-400 hover:underline">
							¿Olvidaste tu contraseña?
						</a>
					</div>

					<!-- Single Submit Button -->
					<button type="submit" id="submitBtn"
						class="w-full bg-black hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 text-center block text-sm shadow-sm">
						Iniciar sesión
					</button>
				</form>

				<div class="relative mt-6 mb-4">
					<div class="absolute inset-0 flex items-center">
						<div class="w-full border-t border-gray-300 dark:border-gray-700"></div>
					</div>
					<div class="relative flex justify-center text-sm">
						<span class="px-2 bg-white dark:bg-gray-950 text-gray-500">O continuar con</span>
					</div>
				</div>

				<button type="button" id="googleBtn" class="w-full flex items-center justify-center gap-2 bg-white dark:bg-gray-900 border border-gray-300 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-800 text-gray-700 dark:text-gray-300 font-semibold py-3 px-4 rounded-xl transition duration-200 text-sm shadow-sm">
					<svg class="w-5 h-5" viewBox="0 0 24 24">
						<path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
						<path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
						<path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
						<path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
					</svg>
					Google
				</button>



				<!-- Toggle between login and registration -->
				<div class="text-center text-xs text-gray-500 dark:text-gray-400 pt-2">
					<span id="toggleQuestion">¿Sin cuenta?</span>
					<button type="button" id="toggleModeBtn" class="text-blue-600 dark:text-blue-400 font-semibold hover:underline ml-1">
						Regístrate gratis
					</button>
				</div>
			</div>
		</div>
	</div>
</Layout>

<script>
	document.getElementById('googleBtn')?.addEventListener('click', async () => {
		try {
			const { signIn } = await import("auth-astro/client");
			signIn('google');
		} catch (e) {
			console.error("auth-astro no está disponible, usando fallback", e);
			window.location.href = '/api/auth/signin/google';
		}
	});
</script>

<script define:vars={{ API_URL }}>
	// Si ya está autenticado, redirigir directo al dashboard
	if (localStorage.getItem('financeai_token')) {
		window.location.href = '/dashboard';
	}

	let isRegisterMode = false;
	const form = document.getElementById('authForm');
	const submitBtn = document.getElementById('submitBtn');
	const alertBox = document.getElementById('alertBox');
	const formTitle = document.getElementById('formTitle');
	const formSubtitle = document.getElementById('formSubtitle');
	const registerFields = document.getElementById('registerFields');
	const forgotPasswordContainer = document.getElementById('forgotPasswordContainer');
	const toggleQuestion = document.getElementById('toggleQuestion');
	const toggleModeBtn = document.getElementById('toggleModeBtn');

	// Toggle para ver/ocultar contraseña
	const togglePasswordBtn = document.getElementById('togglePasswordBtn');
	const passwordInput = document.getElementById('password');
	const eyeIcon = document.getElementById('eyeIcon');
	const eyeOffIcon = document.getElementById('eyeOffIcon');

	if (togglePasswordBtn && passwordInput) {
		togglePasswordBtn.addEventListener('click', () => {
			const isPassword = passwordInput.getAttribute('type') === 'password';
			if (isPassword) {
				passwordInput.setAttribute('type', 'text');
				eyeIcon.classList.add('hidden');
				eyeOffIcon.classList.remove('hidden');
			} else {
				passwordInput.setAttribute('type', 'password');
				eyeIcon.classList.remove('hidden');
				eyeOffIcon.classList.add('hidden');
			}
		});
	}

	function showAlert(msg, isError = true) {
		alertBox.className = `p-3.5 rounded-xl text-xs font-medium ${
			isError
				? 'bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-800'
				: 'bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800'
		}`;
		alertBox.textContent = msg;
		alertBox.classList.remove('hidden');
	}

	function hideAlert() {
		alertBox.classList.add('hidden');
	}

	toggleModeBtn.addEventListener('click', () => {
		isRegisterMode = !isRegisterMode;
		hideAlert();

		if (isRegisterMode) {
			formTitle.textContent = 'Crear cuenta nueva';
			formSubtitle.textContent = 'Ingresa tus datos para registrarte';
			submitBtn.textContent = 'Registrarse';
			submitBtn.className = 'w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 text-center block text-sm shadow-sm';
			registerFields.classList.remove('hidden');
			forgotPasswordContainer.classList.add('hidden');
			toggleQuestion.textContent = '¿Ya tienes una cuenta?';
			toggleModeBtn.textContent = 'Inicia sesión';
		} else {
			formTitle.textContent = 'Bienvenido de nuevo';
			formSubtitle.textContent = 'Accede a tu panel financiero';
			submitBtn.textContent = 'Iniciar sesión';
			submitBtn.className = 'w-full bg-black hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-xl transition duration-200 text-center block text-sm shadow-sm';
			registerFields.classList.add('hidden');
			forgotPasswordContainer.classList.remove('hidden');
			toggleQuestion.textContent = '¿Sin cuenta?';
			toggleModeBtn.textContent = 'Regístrate gratis';
		}
	});

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		hideAlert();

		const email = document.getElementById('email').value.trim();
		const password = document.getElementById('password').value;

		submitBtn.disabled = true;
		submitBtn.textContent = 'Procesando...';

		try {
			if (isRegisterMode) {
				const nombre = document.getElementById('nombre').value.trim();
				const apellido = document.getElementById('apellido').value.trim();
				const paisId = parseInt(document.getElementById('paisId').value);
				const monedaId = parseInt(document.getElementById('monedaId').value);

				const res = await fetch(`${API_URL}/api/v1/auth/register`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						nombre,
						apellido,
						email,
						password,
						paisId,
						monedaId
					})
				});

				const data = await res.json();
				if (res.ok) {
					showAlert('¡Cuenta creada con éxito! Iniciando sesión...', false);
					setTimeout(async () => {
						const loginRes = await fetch(`${API_URL}/api/v1/auth/login`, {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ email, password })
						});
						if (loginRes.ok) {
							const loginData = await loginRes.json();
							localStorage.setItem('financeai_token', loginData.token);
							localStorage.setItem('financeai_user', JSON.stringify(loginData));
							window.location.href = '/dashboard';
						} else {
							toggleModeBtn.click();
						}
					}, 800);
				} else {
					showAlert(data.message || data.mensaje || data.error || 'No fue posible registrar la cuenta.');
				}
			} else {
				const res = await fetch(`${API_URL}/api/v1/auth/login`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ email, password })
				});

				let data = {};
				try {
					data = await res.json();
				} catch (e) {
					console.error("Error al parsear JSON del backend", e);
				}

				if (res.ok && data.token) {
					localStorage.setItem('financeai_token', data.token);
					localStorage.setItem('financeai_user', JSON.stringify(data));
					showAlert('¡Bienvenido! Redirigiendo...', false);
					setTimeout(() => {
						window.location.href = '/dashboard';
					}, 400);
				} else {
					const errorMsg = data.message || data.mensaje || data.error || 'Credenciales inválidas o correo no registrado.';
					showAlert(errorMsg);
					window.alert("Acceso Denegado\n\n" + errorMsg);
				}
			}
		} catch (err) {
			const errorText = 'Error de conexión con el servidor. Por favor, verifica que el Backend esté activo o inténtalo más tarde.';
			showAlert(errorText);
			window.alert("Error de Conexión\n\n" + errorText);
		} finally {
			submitBtn.disabled = false;
			submitBtn.textContent = isRegisterMode ? 'Registrarse' : 'Iniciar sesión';
		}
	});
</script>
