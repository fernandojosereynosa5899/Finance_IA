<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="refresh" content="0;url=/login" />
    <title>Redirigiendo a FinanceAI...</title>
    <script is:inline>
        // Redirigir de inmediato al login si no hay sesion, o al dashboard si esta autenticado
        const token = localStorage.getItem('financeai_token');
        if (token) {
            window.location.replace('/');
        } else {
            window.location.replace('/login');
        }
    </script>
</head>
<body class="bg-gray-950 text-white min-h-screen flex items-center justify-center font-sans">
    <div class="text-center space-y-3">
        <div class="flex justify-center space-x-2">
            <div class="w-3 h-3 rounded-full bg-blue-500 animate-bounce"></div>
            <div class="w-3 h-3 rounded-full bg-red-500 animate-bounce [animation-delay:0.2s]"></div>
            <div class="w-3 h-3 rounded-full bg-yellow-400 animate-bounce [animation-delay:0.4s]"></div>
        </div>
        <p class="text-sm text-gray-400">Página no encontrada. Redirigiendo al inicio de sesión...</p>
    </div>
</body>
</html>
